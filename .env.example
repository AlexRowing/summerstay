# Neon Postgres pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Email alerts to hosts (optional; skipped when unset). From resend.com.
RESEND_API_KEY=""
# A sender on a domain you've verified in Resend
EMAIL_FROM="SummerStay <hello@yourdomain.com>"

# Photo uploads. Vercel sets this when a Blob store is connected to the project;
# run `vercel env pull` to get it locally.
BLOB_READ_WRITE_TOKEN=""

# Public URL used in email links (defaults to https://summerstay.vercel.app)
NEXT_PUBLIC_SITE_URL="https://summerstay.vercel.app"

# Comma-separated emails of moderators. They get report emails and can open /admin.
ADMIN_EMAILS="you@example.com"
