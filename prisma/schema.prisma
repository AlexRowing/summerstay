// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// One apartment listing. Mirrors the Listing type the app already uses.
model Listing {
  id               String   @id @default(cuid())
  title            String
  city             String
  neighborhood     String
  pricePerMonth    Int
  bedrooms         Int
  bathrooms        Int
  distanceToCampus String
  // Human-readable dates ("May 15 - Aug 15"). For listings posted with real
  // dates this is generated from startDate/endDate; older listings only have
  // the text.
  availability     String
  startDate        DateTime?
  endDate          DateTime?
  // Set by the host once someone has taken the place. Taken listings drop out
  // of search but stay viewable at their URL.
  isTaken          Boolean  @default(false)
  // Set when a moderator takes the listing down after a report. Removed
  // listings disappear for everyone except the owner and admins.
  removedAt        DateTime?
  description      String
  // Stored as a JSON string and parsed in app/_lib/listings.ts. Kept as-is
  // through the SQLite->Postgres migration to keep the schema identical; a
  // later change can switch this to a native Postgres text[] array.
  amenities        String
  // The cover photo (always photos[0] when photos exist). Kept as its own
  // column so cards and older rows keep working.
  imageUrl         String
  // Every uploaded photo, in display order. Empty for older listings.
  photos           String[] @default([])
  createdAt        DateTime @default(now())
  inquiries        Inquiry[]
  savedBy          SavedListing[]
  reports          Report[]
  // Who posted this listing. Nullable because the seeded starter listings have
  // no owner; listings created through the form after auth get an owner.
  owner            User?     @relation(fields: [ownerId], references: [id])
  ownerId          String?
}

// A registered host/renter. Passwords are stored only as a bcrypt hash.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  listings     Listing[]
  // A Virginia Tech address the user proved they own (can differ from the
  // login email). Set together with vtVerifiedAt; drives the verified badge.
  vtEmail      String?   @unique
  vtVerifiedAt DateTime?
  emailTokens  EmailToken[]
  saved        SavedListing[]
  searchAlerts SearchAlert[]
}

// A listing someone hearted.
model SavedListing {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  createdAt DateTime @default(now())

  @@id([userId, listingId])
}

// "Email me when a new place matches this search." The filters mirror the
// browse page's URL params.
model SearchAlert {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  q         String?
  maxPrice  Int?
  bedrooms  Int?
  term      String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Someone flagged a listing. Moderators review these on /admin.
model Report {
  id         String    @id @default(cuid())
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId  String
  reason     String    // "scam" | "inaccurate" | "unavailable" | "inappropriate" | "other"
  details    String?
  email      String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([resolvedAt])
}

// One-time links sent by email: verifying a @vt.edu address, or resetting a
// password. Only a SHA-256 hash of the token is stored, so a database leak
// can't be used to click someone else's link.
model EmailToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  purpose   String   // "verify_vt" | "reset_password"
  // The address the link was sent to (the @vt.edu address for verify_vt).
  email     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, purpose])
}

// A message from a prospective subletter about one listing. This is the
// honest, scoped version of "contact host": it records interest; it is not a
// full messaging system.
model Inquiry {
  id        String   @id @default(cuid())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
  // When the host first saw it in their inbox; null means unread.
  readAt    DateTime?
}
